  "info": {
    "title": "FLENVN API",
    "description": "",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "example": "secret123"
          },
          "username": {
            "type": "string",
            "example": "bill"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "example": "secret123"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "CreateSubscriptionPlanDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Free"
          },
          "description": {
            "type": "string",
            "example": "Default free plan"
          },
          "price": {
            "type": "number",
            "example": 0
          },
          "maxBooks": {
            "type": "number",
            "example": 5
          },
          "maxWords": {
            "type": "number",
            "example": 50000
          },
          "maxFlashcards": {
            "type": "number",
            "example": 100
          },
          "features": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            },
            "example": {
              "exportEnabled": false
            }
          },
          "isActive": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "name",
          "price",
          "maxBooks",
          "maxWords",
          "maxFlashcards"
        ]
      },
      "UpgradeSubscriptionDto": {
        "type": "object",
        "properties": {
          "planId": {
            "type": "string",
            "example": "f2e9b30d-2ac8-4b57-a0f6-3acda8e1f4f3"
          }
        },
        "required": [
          "planId"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "example": "new_username"
          },
          "email": {
            "type": "string",
            "example": "new_email@example.com"
          }
        }
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "oldPassword": {
            "type": "string",
            "minLength": 6,
            "example": "oldSecret123"
          },
          "newPassword": {
            "type": "string",
            "minLength": 6,
            "example": "newSecret123"
          },
          "confirmPassword": {
            "type": "string",
            "minLength": 6,
            "example": "newSecret123"
          }
        },
        "required": [
          "oldPassword",
          "newPassword",
          "confirmPassword"
        ]
      },
      "CreateBookDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 255,
            "example": "English Basics"
          },
          "description": {
            "type": "string",
            "example": "A beginner guide."
          },
          "author": {
            "type": "string",
            "example": "Bill H"
          },
          "content": {
            "type": "string",
            "example": "Book body content..."
          },
          "coverImage": {
            "type": "string",
            "example": "https://cdn.example.com/cover.jpg"
          },
          "isPublic": {
            "type": "boolean",
            "example": false
          }
        },
        "required": [
          "title"
        ]
      },
      "UpdateBookDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 255,
            "example": "English Basics"
          },
          "description": {
            "type": "string",
            "example": "Updated description"
          },
          "author": {
            "type": "string",
            "example": "Bill H"
          },
          "content": {
            "type": "string",
            "example": "Updated content"
          },
          "coverImage": {
            "type": "string",
            "example": "https://cdn.example.com/cover.jpg"
          },
          "isPublic": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "CreateFlashcardDto": {
        "type": "object",
        "properties": {
          "word": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "resilient"
          },
          "pronunciation": {
            "type": "string",
            "example": "/rɪˈzɪl.i.ənt/"
          },
          "definition": {
            "type": "string",
            "example": "Able to recover quickly from difficulties."
          },
          "translation": {
            "type": "string",
            "example": "linh hoat"
          },
          "audioUrl": {
            "type": "string",
            "example": "https://cdn.example.com/audio.mp3"
          },
